{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:testbench:scenario:v1",
  "title": "Testbench scenario",
  "description": "One business test case. Written by hand or generated from a business requirement; the engine only executes this structure.",
  "type": "object",
  "required": [
    "scenario",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "description": "Format version.",
      "const": 1
    },
    "scenario": {
      "description": "Short title of the business case.",
      "type": "string",
      "minLength": 1
    },
    "requirement": {
      "description": "The business requirement in the words of the person who wrote it, kept verbatim so reports show it next to the result.",
      "type": "string"
    },
    "description": {
      "description": "Optional notes: assumptions, how the requirement was translated, open questions.",
      "type": "string"
    },
    "connection": {
      "description": "Connection name from testbench.yaml. Optional when suite.yaml sets a default.",
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "select": {
      "description": "SQL that finds the real records representing this scenario. Checks reference it with {{ selection }}. When it returns no rows, the scenario is skipped (not passed).",
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "name",
        "query",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "connection": {
          "description": "Overrides the scenario connection for this check.",
          "type": "string",
          "minLength": 1
        },
        "query": {
          "description": "SQL in the dialect of the connection. May contain {{ selection }}.",
          "type": "string",
          "minLength": 1
        },
        "expect": {
          "$ref": "#/$defs/expect"
        }
      }
    },
    "expect": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "row_count": {
          "description": "Exact number of rows, or a range.",
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "integer",
                  "minimum": 0
                },
                "max": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "all_rows": {
          "description": "Expression(s) every row must satisfy, using column names, for example 'lines == 2' or 'fte > 0 and fte <= 1'.",
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ]
        },
        "equals": {
          "description": "Expected rows, inline or from a CSV file next to the scenario. Order is ignored unless ordered is true.",
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rows": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "csv": {
                  "type": "string"
                },
                "ordered": {
                  "type": "boolean"
                },
                "tolerance": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          ]
        },
        "regression": {
          "description": "Compare with the stored baseline. Keys identify rows; numeric differences within tolerance are accepted.",
          "oneOf": [
            {
              "const": true
            },
            {
              "$ref": "#/$defs/comparison"
            }
          ]
        },
        "reconcile": {
          "description": "Compare with the result of another query, usually on another connection (source versus target).",
          "type": "object",
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "properties": {
            "connection": {
              "type": "string",
              "minLength": 1
            },
            "query": {
              "type": "string",
              "minLength": 1
            },
            "keys": {
              "$ref": "#/$defs/comparison/properties/keys"
            },
            "tolerance": {
              "$ref": "#/$defs/comparison/properties/tolerance"
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "keys": {
          "description": "Columns that identify a row. Without keys, rows are compared as a whole.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tolerance": {
          "description": "Accepted absolute difference for numeric columns.",
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
